DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_CREATE_TABLES=true
MODEL_PATH=models/pretrained_model_01.pkl
# Brevo SMTP: copy login and SMTP key from Brevo > SMTP & API > SMTP.
# The sender must be verified in Brevo. An API key is NOT an SMTP key.
EMAIL_MODE=brevo_smtp
BREVO_SENDER_EMAIL=verified_sender@example.com
BREVO_SENDER_NAME=NewsLens
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SMTP_PORT=2525
# HTTPS alternative if your host blocks SMTP:
# EMAIL_MODE=brevo_api
# BREVO_API_KEY=your_brevo_api_key
# Development without email: EMAIL_MODE=console.
# Optional Flutter Web origins, comma separated; native mobile needs no CORS.
CORS_ORIGINS=http://localhost:3000
APP_PORT=10000
