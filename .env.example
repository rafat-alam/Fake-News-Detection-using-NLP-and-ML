DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379/0
AUTO_CREATE_TABLES=true
MODEL_PATH=models/pretrained_model_01.pkl
# Gmail sends all OTPs using SSL on smtp.gmail.com:465.
EMAIL_MODE=gmail
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
# Development without email: EMAIL_MODE=console.
# Optional Flutter Web origins, comma separated; native mobile needs no CORS.
CORS_ORIGINS=http://localhost:3000
APP_PORT=10000
